# Copy to .kamal/secrets, which is gitignored.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# The API (config/deploy.api.yml). POSTGRES_PASSWORD seeds the accessory on
# first boot; DATABASE_URL is what the app dials, so the two must agree.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://siwe:${POSTGRES_PASSWORD}@siwe-api-postgres:5432/siwe
RESEND_API_KEY=
