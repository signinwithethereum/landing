# Copy to .kamal/secrets, which is gitignored.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# The API (config/deploy.api.yml). POSTGRES_PASSWORD seeds the accessory on
# first boot; DATABASE_URL is what the app dials, so the two must agree. In
# CI, both values come from protected GitHub environment secrets.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=$DATABASE_URL
