{
  "name": "siwe-landing-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "siwe.xyz — the site for Sign-In with Ethereum (ERC-4361)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vitepress dev --port 4321",
    "build": "vitepress build",
    "preview": "vitepress preview --port 4321",
    "typecheck": "vue-tsc --noEmit",
    "og": "chromium --headless --disable-gpu --hide-scrollbars --allow-file-access-from-files --window-size=1200,630 --screenshot=src/public/og.png scripts/og.html",
    "kamal:setup": "set -a && . ./.env.production && set +a && kamal setup",
    "kamal:deploy": "set -a && . ./.env.production && set +a && kamal deploy",
    "kamal:logs": "set -a && . ./.env.production && set +a && kamal app logs -f"
  },
  "devDependencies": {
    "geist": "^1.7.2",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.40",
    "vue-tsc": "^3.1.1"
  }
}
