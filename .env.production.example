# Copy to .env.production, which is gitignored. Never commit real values —
# the repository this replaces committed its deploy host and registry user.
DOCKER_REGISTRY_USERNAME=
DEPLOY_HOST=
APP_HOST=next.siwe.xyz

# The contact/newsletter service (config/deploy.api.yml). The site build bakes
# https://API_HOST in as the form endpoint, so point DNS for it at DEPLOY_HOST.
API_HOST=api.siwe.xyz
# Optional overrides for where the contact form forwards. CONTACT_FROM must be
# on a domain verified in Resend.
# CONTACT_TO=contact@siwe.xyz
# CONTACT_FROM=siwe.xyz <contact@siwe.xyz>
